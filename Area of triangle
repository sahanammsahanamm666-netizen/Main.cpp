#include <iostream>
using namespace std;

int main() {
    float base, height, area;

    cout << "Enter the base of the triangle: ";
    cin >> base;

    cout << "Enter the height of the triangle: ";
    cin >> height;

    area = 0.5 * base * height;

    cout << "Area of the triangle = " << area << endl;

    return 0;
}
